{
  "name": "secure-messenger",
  "version": "1.0.0",
  "description": "Мессенджер со сквозным шифрованием на основе современных криптографических протоколов",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "express": "^4.18.0",
    "better-sqlite3": "^9.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0",
    "concurrently": "^8.2.0"
  }
}
